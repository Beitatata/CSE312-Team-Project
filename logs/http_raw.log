}\n\n    .header-buttons {\n      display: flex;\n      justify-content: center;\n      gap: 10px;\n      margin-bottom: 1rem;\n    }\n\n    .btn {\n      display: inline-block;\n      padding: 8px 20px;\n      border: 2px solid;\n      border-radius: 50px;\n      text-decoration: none;\n      font-family: 'Orbitron', sans-serif;\n      text-transform: uppercase"}
