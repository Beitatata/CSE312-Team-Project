 60, 0.7);\n        }\n        \n        .error-details {\n            background: rgba(231, 76, 60, 0.1);\n            padding: 20px;\n            border-radius: 10px;\n            margin-bottom: 30px;\n            border: 1px solid rgba(231, 76, 60, 0.2);\n            text-align: left;\n        }\n        \n        .error-details p {\n            margin-bottom: 10"}
