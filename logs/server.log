one;\n      font-weight: 700;\n      font-size: 0.9rem;\n      transition: all 0.3s ease;\n      border: 2px solid;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    .btn-home {\n      border-color: var(--light-color);\n    }\n\n    .btn-home:hover {\n      background: var(--light-color);\n      color: var(--dark-color);\n      box-shadow: 0 0 "}
