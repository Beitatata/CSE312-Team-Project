meHost');\n      const btnStart       = document.getElementById('btnStartGame');\n      let username         = \"123\";\n      let currentHost      = null;\n      let users            = [];\n\n      // 1. \u8fdb\uff0f\u51fa\u5927\u5385\n      socket.on('connect',    () => socket.emit('join_lobby'));\n      window.addEventListener('beforeunload', () => socket.emit('leave_lobby'));\n\n      // 2. \u66f4\u65b0\u5728\u7ebf\u5217\u8868\n      socket.on('update_"}
