ansform: uppercase;\n      letter-spacing: 1px;\n      cursor: pointer;\n    }\n    .btn-home { border-color: var(--light-color); }\n    .btn-home:hover {\n      background: var(--light-color);\n      color: var(--dark-color);\n      box-shadow: 0 0 20px rgba(255,255,255,0.3);\n      transform: translateY(-3px);\n    }\n    .btn-danger { border-color: var"}
